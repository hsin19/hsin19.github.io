---
import Seal from "../components/Seal.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Not found — Eric Yeh">
    <main class="container lost">
        <Seal class="lost-seal" decorative />
        <p class="eyebrow">404</p>
        <h1>Lost in the woods.</h1>
        <p>This page wandered off. The trail home is right here.</p>
        <a href="/">← Back to the start</a>
    </main>
</Base>

<style>
.lost {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    min-height: 100dvh;
}

.lost :global(.lost-seal) {
    width: 4rem;
    rotate: -8deg;
    margin-bottom: 1rem;
}

h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 0.95;
}

p:not(.eyebrow) {
    color: var(--ink-2);
}

a {
    margin-top: 1rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.25em;
}
</style>
