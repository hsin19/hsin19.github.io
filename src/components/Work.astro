---
import { Image } from "astro:assets";
import {
    featured,
    more,
} from "../data/projects";
---

<section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
        <header class="section-head reveal">
            <p class="eyebrow">02 — Selected work</p>
            <h2 id="work-title">Things I built for myself, then shipped</h2>
        </header>

        <ul class="featured">
            {featured.map((project, index) => (
                <li class:list={["card reveal", { lead: index === 0 }]} style={`--tint: ${project.tint}`}>
                    <Image class="icon" src={project.icon} alt="" width={96} height={96} />
                    <div class="body">
                        <h3>{project.name}</h3>
                        <p class="kicker">{project.kicker}</p>
                        <p class="description">{project.description}</p>
                        <ul class="tags" aria-label="Built with">
                            {project.stack.map(item => <li>{item}</li>)}
                        </ul>
                        <p class="links">
                            {project.links.map(link => (
                                <a href={link.href}>
                                    {link.label} <span aria-hidden="true">↗</span>
                                </a>
                            ))}
                        </p>
                    </div>
                </li>
            ))}
        </ul>

        <h3 class="more-title reveal">Also in the workshop</h3>
        <ul class="more">
            {more.map(project => (
                <li class="reveal">
                    <a href={project.href}>
                        <span class="more-name">{project.name}</span>
                        <span class="more-description">{project.description}</span>
                        <span class="more-meta">{project.stack.join(" · ")}</span>
                        <span class="more-year">{project.year}</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
.featured {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}

.card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 0.25rem);
    background:
        radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--tint) 16%, transparent), transparent 60%),
        var(--bg-raised);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.4s var(--ease-out);
}

.card:hover {
    border-color: color-mix(in oklab, var(--tint) 45%, var(--line));
}

.card.lead {
    grid-column: 1 / -1;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.75rem, 4vw, 3.25rem);
}

.icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    object-fit: contain;
}

.lead .icon {
    width: clamp(4.5rem, 10vw, 7.5rem);
    height: auto;
    aspect-ratio: 1;
}

.body {
    display: grid;
    gap: 0.875rem;
}

h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.05;
}

.lead h3 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
}

.kicker {
    font-weight: 500;
    text-wrap: balance;
}

.description {
    max-width: 62ch;
    color: var(--ink-2);
    font-size: 0.9688rem;
    text-wrap: pretty;
}

.tags {
    margin-top: 0.25rem;
}

.links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.25rem;
}

.links a {
    font-size: 0.9375rem;
    font-weight: 500;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease-out), color 0.2s;
}

.links a:hover {
    color: var(--accent);
    background-size: 100% 1px;
}

.more-title {
    margin: clamp(3rem, 7vw, 4.5rem) 0 1rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
}

.more {
    border-top: 1px solid var(--line);
}

.more a {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr) auto 3.5rem;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding: 1.25rem 0.25rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s, padding 0.3s var(--ease-out);
}

.more a:hover {
    padding-inline: 0.75rem;
    background: color-mix(in oklab, var(--ink) 4%, transparent);
}

.more-name {
    font-weight: 600;
}

.more-description {
    color: var(--ink-2);
    font-size: 0.9375rem;
}

.more-meta,
.more-year {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
}

.more-year {
    text-align: right;
}

@media (width < 48rem) {
    .featured {
        grid-template-columns: minmax(0, 1fr);
    }

    .card.lead {
        grid-template-columns: minmax(0, 1fr);
    }

    .more a {
        grid-template-columns: minmax(0, 1fr) auto;
    }

    .more-description {
        grid-column: 1 / -1;
        grid-row: 2;
    }

    .more-meta {
        grid-row: 3;
    }

    .more-year {
        grid-row: 3;
    }
}
</style>
