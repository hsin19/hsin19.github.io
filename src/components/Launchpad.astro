---
import { Image } from "astro:assets";
import { launchpad } from "../data/launchpad";

const host = (href: string) => new URL(href).host.replace(/^www\./, "");
---

<section class="section launchpad" id="launchpad" aria-labelledby="launchpad-title">
    <div class="container">
        <header class="section-head reveal">
            <p class="eyebrow">01 — Launchpad</p>
            <h2 id="launchpad-title">Jump straight in</h2>
        </header>
        <ul class="tiles">
            {launchpad.map(item => (
                <li class="reveal">
                    <a class="tile" href={item.href}>
                        {item.icon
                            ? <Image class="icon" src={item.icon} alt="" width={44} height={44} />
                            : <span class="icon monogram" aria-hidden="true">{item.name.slice(0, 1)}</span>}
                        <span class="text">
                            <span class="name">{item.name}</span>
                            <span class="note">{item.note}</span>
                        </span>
                        <span class="host">{host(item.href)}</span>
                        <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
.launchpad {
    padding-top: clamp(2rem, 5vw, 3rem);
}

.tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
}

.tile {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
        "icon text"
        "host host";
    align-items: center;
    gap: 1.25rem 0.875rem;
    height: 100%;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    transition: transform 0.3s var(--ease-out), border-color 0.2s, box-shadow 0.3s;
}

.tile:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: 0 12px 30px -18px color-mix(in oklab, var(--ink) 40%, transparent);
}

.icon {
    grid-area: icon;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    object-fit: contain;
}

.monogram {
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--bg);
    background: var(--ink);
}

.text {
    grid-area: text;
    display: grid;
    min-width: 0;
}

.name {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
}

.note {
    font-size: 0.875rem;
    color: var(--ink-2);
}

.host {
    grid-area: host;
    overflow: hidden;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--ink-3);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.arrow {
    position: absolute;
    top: 1rem;
    right: 1.125rem;
    color: var(--ink-3);
    transition: translate 0.3s var(--ease-out), color 0.2s;
}

.tile:hover .arrow {
    translate: 2px -2px;
    color: var(--accent);
}
</style>
