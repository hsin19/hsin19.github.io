---
import { getProfile } from "../lib/profile";
import Seal from "./Seal.astro";

const year = new Date().getFullYear();

const profile = await getProfile();
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="container">
        <p class="eyebrow reveal">04 — Contact</p>
        <h2 id="contact-title" class="reveal">Say hello.</h2>
        <p class="note reveal">An idea, a project, or a question about anything here — my inbox is open.</p>
        <a class="email reveal" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p class="elsewhere reveal">
            Elsewhere: <a href={profile.github} rel="me">GitHub</a>
        </p>
    </div>
</section>

<footer class="site-footer">
    <div class="container bar">
        <Seal class="footer-seal" decorative />
        <p>© {year} {profile.name} · <span lang="zh-Hant-TW">{profile.nativeName}</span></p>
        <p class="built">Built with <a href="https://astro.build">Astro</a> · <a href={profile.source}>Source</a></p>
    </div>
</footer>

<style>
.contact {
    border-top: 1px solid var(--line);
}

h2 {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 12vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
}

.note {
    max-width: 40ch;
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: 1.125rem;
}

.email {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 5vw, 3rem);
    overflow-wrap: anywhere;
    background: linear-gradient(var(--seal), var(--seal)) 0 100% / 100% 2px no-repeat;
    padding-bottom: 0.15rem;
    transition: color 0.2s, background-size 0.4s var(--ease-out);
}

.email:hover {
    color: var(--seal);
    background-size: 100% 0.35em;
    background-image: linear-gradient(color-mix(in oklab, var(--seal) 14%, transparent), color-mix(in oklab, var(--seal) 14%, transparent));
}

.elsewhere {
    margin-top: 2rem;
    color: var(--ink-3);
    font-size: 0.9375rem;
}

.elsewhere a,
.built a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: color 0.2s, text-decoration-color 0.2s;
}

.elsewhere a:hover,
.built a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
}

.site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
}

.bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
}

.bar :global(.footer-seal) {
    width: 1.5rem;
    rotate: 5deg;
}

.built {
    margin-left: auto;
}
</style>
