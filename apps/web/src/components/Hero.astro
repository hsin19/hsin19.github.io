---
import { getProfile } from "../lib/profile";
import Seal from "./Seal.astro";
import HeroStage from "./stage/HeroStage.astro";

const profile = await getProfile();
---

<section class="hero" id="top">
    <HeroStage />
    <div class="container inner">
        <p class="eyebrow">{profile.role} · {profile.location}</p>
        <h1>
            <span class="name">{profile.name}</span>
            <Seal class="hero-seal" />
        </h1>
        <p class="aka"><span lang="zh-Hant-TW">{profile.nativeName}</span> · {profile.romanizedName}</p>
        <p class="lead">{profile.lead}</p>
        <p class="bio">{profile.bio}</p>
        <div class="actions">
            <a class="button primary" href={profile.github} rel="me">
                GitHub <span aria-hidden="true">↗</span>
            </a>
            <a class="button" href={`mailto:${profile.email}`}>Email me</a>
        </div>
    </div>
</section>

<style>
.hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(5rem, 14vh, 9rem) clamp(4rem, 10vh, 7rem);
    overflow: clip;
}

/* A soft pool of light behind the name. */
.hero::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto;
    height: 120%;
    z-index: -1;
    background:
        radial-gradient(40% 50% at 18% 30%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 70%),
        radial-gradient(35% 45% at 85% 15%, color-mix(in oklab, var(--glow-2) 12%, transparent), transparent 70%);
    pointer-events: none;
}

.inner {
    position: relative;
    z-index: 1;
}

h1 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 0.12em;
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(4.25rem, 15vw, 11rem);
    line-height: 0.88;
    letter-spacing: -0.035em;
}

h1 :global(.hero-seal) {
    width: 0.58em;
    rotate: -7deg;
    translate: 0 0.04em;
}

@media (prefers-reduced-motion: no-preference) {
    .name {
        animation: rise 1s var(--ease-out) both;
    }

    h1 :global(.hero-seal) {
        animation: stamp 0.55s cubic-bezier(0.3, 1.6, 0.5, 1) 0.65s both;
    }

    .aka,
    .lead,
    .bio,
    .actions {
        animation: rise 0.9s var(--ease-out) both;
    }

    .aka {
        animation-delay: 0.15s;
    }
    .lead {
        animation-delay: 0.25s;
    }
    .bio {
        animation-delay: 0.35s;
    }
    .actions {
        animation-delay: 0.45s;
    }
}

@keyframes rise {
    from {
        opacity: 0;
        translate: 0 1.25rem;
    }
}

/* Pressed onto the page: drops in large, lands with a little give. */
@keyframes stamp {
    from {
        opacity: 0;
        scale: 1.8;
        rotate: -18deg;
    }
    60% {
        opacity: 1;
    }
}

.aka {
    margin-top: 1.25rem;
    font-family: var(--font-code);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
}

.aka span {
    font-family: var(--font-body);
    letter-spacing: 0.2em;
    color: var(--ink);
}

.lead {
    max-width: 34ch;
    margin-top: clamp(2rem, 5vw, 3rem);
    font-family: var(--font-serif);
    font-size: clamp(1.625rem, 3.4vw, 2.375rem);
    line-height: 1.18;
    text-wrap: balance;
}

.bio {
    max-width: 60ch;
    margin-top: 1.25rem;
    color: var(--ink-2);
    text-wrap: pretty;
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
}

.button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    background: var(--bg-raised);
    transition: transform 0.25s var(--ease-out), border-color 0.2s, background-color 0.2s;
}

.button:hover {
    transform: translateY(-2px);
    border-color: var(--ink-3);
}

.button.primary {
    border-color: transparent;
    background: var(--ink);
    color: var(--bg);
}

.button.primary:hover {
    background: color-mix(in oklab, var(--ink) 88%, var(--accent));
}
</style>
